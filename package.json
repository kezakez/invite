{
  "name": "invite",
  "version": "1.0.0",
  "description": "An invite site that uses google sheets to store the responses",
  "main": "dist/index.js",
  "author": "Keza",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint 'src/**/*.ts'",
    "test": "NODE_ENV=test jest --coverage --no-cache",
    "watch-test": "NODE_ENV=test jest --coverage --no-cache --watchAll",
    "watch": "tsc-watch --onSuccess \"node --inspect dist/index.js\" --onFailure \"echo tsc-watch detected a compilation failure\"",
    "build": "yarn build:compile && yarn build:docker",
    "build:compile": "rm -rf dist && tsc -p .",
    "build:docker": "docker build ./ -f ./Dockerfile -t kezakez/invite:latest",
    "start": "NODE_ENV=production node dist/index.js"
  },
  "prettier": {
    "arrowParens": "always",
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all",
    "printWidth": 80
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "googleapis": "^176.0.0",
    "luxon": "^3.7.2",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "tsc-watch": "^7.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
